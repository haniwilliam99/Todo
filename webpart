            {
                foreach (GridViewRow grv in grdCompanyRegistrationDocs.Rows)
                {
                    CustomValidator CustomValidatorfileSize = ((CustomValidator)grv.FindControl("CustomValidatorfileSize"));
                    FileUpload fupAttachDoc = ((FileUpload)grv.FindControl("fupAttachDoc"));

                    if (CustomValidatorfileSize != null && fupAttachDoc != null)
                    {
                        if (fupAttachDoc.PostedFile.ContentLength > 1024)
                        {
                            args.IsValid = false;
                        }
                        else
                        {
                            args.IsValid = true;
                        }
                    }
                }
            }

        }

        private bool CRNCheck()
        {
            bool status = true;
            Security.RunWithElevatedPrivelligesAndContextSwitch(delegate
            {
                try
                {
                    if (!string.IsNullOrEmpty(txtCommercialRegistrationNumber.Text))
                    {
                        {
                            if (!CompanyHelper.IsCRNUnique(txtCommercialRegistrationNumber.Text.Trim(), strSiteUrl, null))
                            {
                                ShowNotification(Util.GetLocalizedValue("CommercialRegistrationNumberExist", Util.ResourceFile.EPAResource), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                                txtCommercialRegistrationNumber.Text = string.Empty;
                                txtCommercialRegistrationNumber.Focus();
                                status = false;
                            }
                            else if (!CompanyRequestHelper.IsCRNUnique(txtCommercialRegistrationNumber.Text.Trim(), strSiteUrl, null))
                            {
                                ShowNotification(Util.GetLocalizedValue("CommercialRegistrationNumberExist", Util.ResourceFile.EPAResource), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                                txtCommercialRegistrationNumber.Text = string.Empty;
                                txtCommercialRegistrationNumber.Focus();
                                status = false;
                            }
                            else { txtMainUserNameArabic.Focus(); }
                        }
                    }
                }
                catch (Exception ex)
                {
                    ExceptionLogger.LogExceptionAnonymous("CompanyDetails", "CRNCheck", ex, strSiteUrl);
                    txtCommercialRegistrationNumber.Text = string.Empty;
                    txtCommercialRegistrationNumber.Focus();
                    status = false;
                }
            });
