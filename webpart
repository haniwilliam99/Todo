                    txtSecondaryUserDesignation.Enabled = chkSecondaryUserDetails.Checked;
                    txtSecondaryUserMobile.Enabled = chkSecondaryUserDetails.Checked;
                    txtSecondaryUserEmailID.Enabled = chkSecondaryUserDetails.Checked;
                    chkSecondaryUserDetails.Enabled=false;

