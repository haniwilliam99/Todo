        private bool isValidateRequi1redDocuments(CivilIDAttachment attchment)
        {
            try
            {

                int iFileSize = attchment.FileBytes.Length;
                string fileSize = string.Empty;
                Security.RunWithElevatedPrivelligesAndContextSwitch(delegate
                {
                    fileSize = Configuration.GetConfigurationValue(ConfigurationKey.MaxFileSizeInMB, strSiteUrl);
                });

                int MaxAllowedFIlesize = Convert.ToInt32(fileSize) * 1000000;

                if (iFileSize > MaxAllowedFIlesize)
                {
                    return false;
                }

            }
            catch (Exception ex)
            {
                ExceptionLogger.LogExceptionAnonymous("CompanyDetails", "checking file size of civilID copies", ex, strSiteUrl);
            }
            return true;
        }



