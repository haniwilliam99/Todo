            ViewState["SecondaryUserPassword"] = Security.ResetUserPassword(txtSecondaryUserName.Text);
            ShowNotification(Util.GetLocalizedValue("passwordgeneratesuccess", Util.ResourceFile.EPAMessage), EPAOzoneDAL.Enumerations.NotificationTypes.Success, false);
