        protected void Page_Load(object sender, EventArgs e)
        {
            if (!Page.IsPostBack)
            {
                revPassword.ValidationExpression = @"^(?=.*\d)(?=.*[a-z]*)(?=.*\W+)(?=.*[A-Z]*)(?=.*(([a-z]+)|([A-Z]+))).{8,12}$";
                revConfirmPassword.ValidationExpression = @"^(?=.*\d)(?=.*[a-z]*)(?=.*\W+)(?=.*[A-Z]*)(?=.*(([a-z]+)|([A-Z]+))).{8,12}$";
                revSecondaryPassword.ValidationExpression = @"^(?=.*\d)(?=.*[a-z]*)(?=.*\W+)(?=.*[A-Z]*)(?=.*(([a-z]+)|([A-Z]+))).{8,12}$";
                revSecondaryConfirmPassword.ValidationExpression = @"^(?=.*\d)(?=.*[a-z]*)(?=.*\W+)(?=.*[A-Z]*)(?=.*(([a-z]+)|([A-Z]+))).{8,12}$";
                LocalizeControls();
                LoadControls();
                ApplyValidation();

                if (Page.Request.QueryString != null)
                {
                    if (Page.Request.QueryString.Count > 0)
                        if (Page.Request.QueryString["cid"] != null)
                        {
                            byte[] dec = HttpServerUtility.UrlTokenDecode(Page.Request.QueryString["cid"].ToString());
                            hdnCompanyID.Value = Encoding.UTF8.GetString(dec);
                        }
                }


                if (IsEPAEmpOrHead())
                {
                    if (!string.IsNullOrEmpty(hdnCompanyID.Value))
                    {

                        lblh1CompanyHeader.InnerText = Util.GetLocalizedValue("UpdateCompanyDetails", Util.ResourceFile.EPAResource);
                        hdnAddEditMode.Value = "Update";
                        HideShowControlsOnUpdate(true);
                        GetCompanyDetails();

                    }
                    else
                    {
                        hdnAddEditMode.Value = "Add";
                        HideShowControlsOnUpdate(false);
                    }
                }

                else
                {

                    if (string.IsNullOrEmpty(hdnCompanyID.Value))
                    {
                        var ci = CompanyHelper.GetCompanyByUserAccountID(SPContext.Current.Web.CurrentUser.ID);
                        if (ci != null)
                            hdnCompanyID.Value = ci.Id.ToString();
                    }

                    if (string.IsNullOrEmpty(hdnCompanyID.Value))
                        Page.Response.Redirect(SPContext.Current.Site.Url);

                    HideShowControlsOnUpdate(false);
                    ViewCompanyDetails();

                    lblh1CompanyHeader.InnerText = Util.GetLocalizedValue("ViewCompanyProfile", Util.ResourceFile.EPAResource);


                }

                if (Page.Request.QueryString["updPro"] != null)
                {
                    // btnUpdateProfile.Visible = true;
                    txtCommercialRegistrationNumber.Enabled = true;
                    rfvCRN.ValidationGroup = "updateProfile";

                }

                if (IsEPAEmpOrHead())
                {
                    btnApplychangeRequest.Visible= false;
                }
                else
                {
                    btnApplychangeRequest.Visible= true;
                }



            }
        }

        private static bool IsEPAEmpOrHead()
        {
            return Security.IsUserInGroup(Security.SecurityGroups.EPAEmployees, SPContext.Current.Web.CurrentUser.ID)
                                || Security.IsUserInGroup(Security.SecurityGroups.EPADivisionHeads, SPContext.Current.Web.CurrentUser.ID);
        }

