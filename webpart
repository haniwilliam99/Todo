        protected void btnUpdateProfile_Click(object sender, EventArgs e)
        {
            try
            {
                string fileSize = string.Empty;
                Security.RunWithElevatedPrivelligesAndContextSwitch(delegate
                {
                    fileSize = Configuration.GetConfigurationValue(ConfigurationKey.MaxFileSizeInMB, strSiteUrl);
                });
                bool isValidData = true;
                if (!string.IsNullOrEmpty(txtCommercialRegistrationNumber.Text.Trim()))
                {
                    if (Page.Session["MainUserCivilIDCopy"] != null)
                    {
                        if (isValidateRequi1redDocuments((CivilIDAttachment)Page.Session["MainUserCivilIDCopy"]))
                        {
                            isValidData = true;
                        }
                        else
                        {

                            ShowNotification(string.Format(Util.GetLocalizedValue("MaxFileSize", Util.ResourceFile.EPAMessage), fileSize), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                            return;
                        }
                    }
                    else
                    {
                        ShowNotification(Util.GetLocalizedValue("mainuserCivilIDcopyrequired", Util.ResourceFile.EPAMessage), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);


                        return;
                    }
                    if (chkSecondaryUserDetails.Checked)
                    {
                        if (Page.Session["SecondaryUserCivilIDCopy"] != null)
                        {
                            if (isValidateRequi1redDocuments((CivilIDAttachment)Page.Session["SecondaryUserCivilIDCopy"]))
                            {
                                isValidData = true;
                            }
                            else
                            {
                                ShowNotification(string.Format(Util.GetLocalizedValue("MaxFileSize", Util.ResourceFile.EPAMessage), fileSize), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                                return;
                            }
                        }
                        else
                        {
                            ShowNotification(Util.GetLocalizedValue("Secondarycopyrequired", Util.ResourceFile.EPAMessage), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);

                            return;
                        }
                    }
                    else
                    {
                        isValidData = true;
                    }

                }
                else
                {
                    ShowNotification(Util.GetLocalizedValue("PleaseenterCRNNumber", Util.ResourceFile.EPAResource), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                    txtCommercialRegistrationNumber.Text = string.Empty;
                    txtCommercialRegistrationNumber.Focus();
                    return;
                }

                if (isValidData)
                {
                    UpdateProfileCRNandAttachments();
                }
            }
            catch (Exception ex)
            {
                ExceptionLogger.LogException("CompanyDetailWebPart", "UpdateProfile-CRN, CivilID Copies", ex);
            }
        }

        protected void txtComCentralNumber_TextChanged(object sender, EventArgs e)
        {
            lblValidLicense.Visible = false;
            txtCommercialRegistrationNumber.Text = "";
            txtCompanyNameArabi.Text = "";
            txtCompanyNameEnglish.Text = "";
            TradeService tservice = new TradeService();
            EPAOzoneDAL.TradeWebService.P_LICN licInfo = tservice.getLicInfoByCentralNumber(txtComCentralNumber.Text.Trim());
            if (licInfo.Status == "1")
            {
                lblValidLicense.Visible = true;
                txtCommercialRegistrationNumber.Text = licInfo.LICN_DATA.COMM_BOOK_NO;
                txtCompanyNameArabi.Text = licInfo.LICN_DATA.COMPANY_NAME;
                // txtCompanyNameEnglish.Text = licInfo.LICN_DATA.COMPANY_NAME;
                hdnLicIssueDate.Value = licInfo.LICN_DATA.LICN_COMM_SDATE;
                hdnLicEndDate.Value = licInfo.LICN_DATA.LICN_COMM_EDATE;
                hdnLicCivilID.Value = licInfo.LICN_DATA.LICN_CIVIL_ID;
                txtLicIssuedDate.Text = licInfo.LICN_DATA.LICN_COMM_SDATE;
                txtLicExpiryDate.Text = licInfo.LICN_DATA.LICN_COMM_EDATE;
                lblValidLicense.InnerText = Util.GetLocalizedValue("ValidLicense", Util.ResourceFile.EPAMessage);
            }
            else if (licInfo.Status == "0")
            {
                ShowNotification(Util.GetLocalizedValue("InvalidCentralNumber", Util.ResourceFile.EPAMessage), NotificationTypes.Warning, false);
                txtComCentralNumber.Text = "";
            }
            else if (licInfo.Status == "2")
            {
                ShowNotification(Util.GetLocalizedValue("LicenseStopped", Util.ResourceFile.EPAMessage), NotificationTypes.Warning, false);
                txtComCentralNumber.Text = "";
            }
            else
            {
                ShowNotification(Util.GetLocalizedValue("SomethingWrong", Util.ResourceFile.EPAMessage), NotificationTypes.Warning, false);
                txtComCentralNumber.Text = "";

            }
        }

