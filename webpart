                txtMainUserNameArabic.Text = objUser1.NameArabic;
                txtMainUserNameEnglish.Text = objUser1.Title;
                txtMainUserCivilID.Text = objUser1.CivilID;
                txtMainUserDesignation.Text = objUser1.Designation;
                txtMainUserMobile.Text = objUser1.MobileNumber;
                txtMainUserEmailID.Text = objUser1.Email;
                //txtMainUserLandline.Text = objUser1.PhoneNumber;
                txtUserName.Text = objUser1.UserAccountName;
                txtMainUserSerialNumber.Text = objUser1.SerialNumber;
                hlCivilIdCopy1.Visible=false;
                hlCivilCopy2.Visible=false;
                if (!string.IsNullOrWhiteSpace(objUser1.CivilIdFilePath))
                {

                    hlCivilIdCopy1.NavigateUrl= FileServerHelper.GetSecureURL(objUser1.CivilIdFilePath); //FileServerHelper.CDNURL+objUser1.CivilIdFilePath;
                    hlCivilIdCopy1.Visible= true;

                }


                //Populate secondary user detail
                if (lstCompanyUsers.Count > 1)
                {
                    objUser1 = lstCompanyUsers[1];

                    chkSecondaryUserDetails.Checked = true;
                    txtSecondaryUserNameArabic.Text = objUser1.NameArabic;
                    txtSecondaryUserNameEnglish.Text = objUser1.Title;
                    txtSecondaryUserCivilID.Text = objUser1.CivilID;
                    txtSecondaryUserDesignation.Text = objUser1.Designation;
                    txtSecondaryUserMobile.Text = objUser1.MobileNumber;
                    txtSecondaryUserEmailID.Text = objUser1.Email;
                    // txtSecondaryUserLandline.Text = objUser1.PhoneNumber;
                    txtSecondaryUserName.Text = objUser1.UserAccountName;
                    txtSecondaryUserSerialNumber.Text = objUser1.SerialNumber;

