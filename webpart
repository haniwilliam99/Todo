        private void LoadDoc(bool IsLoadOld = false)
        {

            var obj = CompanyHelper.GetCompanyRegistrationDocuments();
            obj = obj.Where(x => x.Order != 2).ToList();
            if (!chkSecondaryUserDetails.Checked)
            {
                obj=  obj.Where(x => x.Order != 5).ToList();
            }
            grdCompanyRegistrationDocs.DataSource = obj;
            grdCompanyRegistrationDocs.DataBind();
            if (IsLoadOld)
            {
                var CompanyID = Convert.ToInt32(hdnCompanyID.Value);
                BindRequiredAttachmentDocs(CompanyID);
            }
