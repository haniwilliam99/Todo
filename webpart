        private void AttachmentDelete(GridViewDeleteEventArgs e)
        {
            try
            {
                ArrayList documentAttachmentsTemp = new ArrayList();
                if (ViewState["lstTempDelete"] != null)
                {
                    documentAttachmentsTemp = (ArrayList)ViewState["lstTempDelete"];
                    documentAttachmentsTemp.Add(Convert.ToInt32(e.Keys[0]));
