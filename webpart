        private void BindRequiredAttachmentDocs(int CompanyID)
        {

            if (grdCompanyRegistrationDocs.Rows.Count > 0)
            {
                try
                {
                    Dictionary<int, string> documentAttachments = new Dictionary<int, string>();
                    documentAttachments = CompanyHelper.GetCompanyRegistrationAttachments(CompanyID);

                    if (documentAttachments.Count > 0)
                    {
                        grdCompanyRegistrationDocs.Columns[2].Visible = true;
                        grdCompanyRegistrationDocs.Columns[3].Visible = true;

                        if (Security.IsUserInGroup(Security.SecurityGroups.EPAEmployees, SPContext.Current.Web.CurrentUser.ID)
                                    || Security.IsUserInGroup(Security.SecurityGroups.EPADivisionHeads, SPContext.Current.Web.CurrentUser.ID))
                            grdCompanyRegistrationDocs.Columns[3].Visible = true;
                        ArrayList documentAttachmentsTemp = new ArrayList();
                        if (ViewState["lstTempDelete"] != null)
                        {
                            documentAttachmentsTemp = (ArrayList)ViewState["lstTempDelete"];
                        }
                        foreach (GridViewRow grv in grdCompanyRegistrationDocs.Rows)
                        {
                            RequiredFieldValidator rfvDocument = ((RequiredFieldValidator)grv.FindControl("rfvDocument"));
                            //  rfvDocument.Text = strValMsg;
                            if (documentAttachments.ContainsKey(Convert.ToInt32(grdCompanyRegistrationDocs.DataKeys[grv.DataItemIndex].Values["ID"])))
                            {

                                int RowIndex = Convert.ToInt32(grdCompanyRegistrationDocs.DataKeys[grv.DataItemIndex].Values["ID"]);
                                var value = documentAttachments[RowIndex];
                                string url = "";
                                if (!string.IsNullOrWhiteSpace(value)&& value.Contains("OzoneFile"))
                                {
                                    url= FileServerHelper.GetSecureURL(value);//FileServerHelper.CDNURL+ value;
                                }
                                else
                                {
                                    url= "~/"+ value;
                                }
                                if (documentAttachmentsTemp != null && documentAttachmentsTemp.Count > 0)
                                {
                                    if (!documentAttachmentsTemp.Contains(Convert.ToInt32(grdCompanyRegistrationDocs.DataKeys[grv.DataItemIndex].Values["ID"])))
                                    {

                                        rfvDocument.Enabled = false;
                                        ((HyperLink)grv.FindControl("hplViewDocs")).Visible = true;
                                        ((LinkButton)grv.FindControl("lbnDeleteDocs")).Visible = true;
                                        ((HyperLink)grv.FindControl("hplViewDocs")).NavigateUrl =url;

                                    }
                                    else
                                    {
                                        if (Convert.ToBoolean(grdCompanyRegistrationDocs.DataKeys[grv.DataItemIndex].Values["IsRequired"]))
                                        {
                                            rfvDocument.Enabled = true;
                                            ((HyperLink)grv.FindControl("hplViewDocs")).Visible = false;
                                            ((LinkButton)grv.FindControl("lbnDeleteDocs")).Visible = false;
                                        }
                                        else
                                        {
                                            rfvDocument.Enabled = false;
                                            ((HyperLink)grv.FindControl("hplViewDocs")).Visible = false;
                                            ((LinkButton)grv.FindControl("lbnDeleteDocs")).Visible = false;
                                        }

                                    }

                                }
                                else
                                {
                                    rfvDocument.Enabled = false;
                                    ((LinkButton)grv.FindControl("lbnDeleteDocs")).Visible = true;
                                    ((HyperLink)grv.FindControl("hplViewDocs")).Visible = true;
                                    ((HyperLink)grv.FindControl("hplViewDocs")).NavigateUrl = url;
                                }

                            }
                            else
                            {
                                //  rfvDocument.Enabled = false;
                                ((HyperLink)grv.FindControl("hplViewDocs")).Visible = false;
                                ((LinkButton)grv.FindControl("lbnDeleteDocs")).Visible = false;

                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    ExceptionLogger.LogException("CompanyDetailWebPart", "BindRequiredAttachmentDocs", ex);
                }
            }
        }
