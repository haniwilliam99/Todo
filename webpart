        protected void grdHistory_RowDataBound(object sender, GridViewRowEventArgs e)
        {
            try
            {
                if (e.Row.RowType == DataControlRowType.Header)
                {
                    e.Row.Cells[0].Text = Util.GetLocalizedValue("CompanyName", Util.ResourceFile.EPAResource);
                    e.Row.Cells[1].Text = Util.GetLocalizedValue("RequestStatus", Util.ResourceFile.EPAResource);
                    e.Row.Cells[2].Text = Util.GetLocalizedValue("Comments", Util.ResourceFile.EPAResource);
                    e.Row.Cells[3].Text = Util.GetLocalizedValue("Date", Util.ResourceFile.EPAResource);
                    e.Row.Cells[4].Text = Util.GetLocalizedValue("ActionBy", Util.ResourceFile.EPAResource);
                }
                if (e.Row.RowType == DataControlRowType.DataRow)
                {
                    var dataItem = e.Row.DataItem as VWCompanyRequestStatusHistory;
                    var row = e.Row;
                    if (Util.IsCurrentCultureArabic())
                    {
                        ((Label)row.FindControl("lblCompany")).Text = dataItem.companyNameArabic;
                    }
                    else
                    {
                        ((Label)row.FindControl("lblCompany")).Text = dataItem.companyTitle;
                    }
                    if (Util.IsCurrentCultureArabic())
                    {


                        ((Label)row.FindControl("lblRequestStatus")).Text = dataItem.RequestStatusNameArabic;

                    }
                    else
                    {
                        ((Label)row.FindControl("lblRequestStatus")).Text = dataItem.RequestStatusTitle;
                    }

                    ((Label)row.FindControl("lblComments")).Text = dataItem.UpdateDetails;
                    if (Util.IsCurrentCultureArabic())
                    {
                        var DTFormat = new System.Globalization.CultureInfo("ar-SA", false).DateTimeFormat;
                        DTFormat.Calendar = new System.Globalization.GregorianCalendar();
                        ((Label)row.FindControl("lblCreated")).Text = dataItem.CreatedAt.Value.ToString("dd/MM/yyyy hh:mm tt", DTFormat);
                    }
                    else
                    {
                        ((Label)row.FindControl("lblCreated")).Text = dataItem.CreatedAt.Value.ToString("dd/MM/yyyy hh:mm tt");

                    }
                    if (!dataItem.RequestStatus.Value.Equals(Convert.ToInt32(EPAOzoneDAL.Enumerations.CompanyRequestStatus.NewRequest)))
                    {
                        ((Label)row.FindControl("lblCreatedBy")).Text = dataItem.CreatedBy;
                    }
                    else
                    {
                        ((Label)row.FindControl("lblCreatedBy")).Text = string.Empty;
                    }

                }
            }
            catch (Exception ex)
            {
                ExceptionLogger.LogException("ApproveCompanyRegistration", "grdHistory_RowDataBound", ex);
            }
        }

