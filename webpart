                    e.Row.Cells[0].Text = Util.GetLocalizedValue("AttachmentDocuments", Util.ResourceFile.EPAResource);
                    e.Row.Cells[1].Text = Util.GetLocalizedValue("Attach", Util.ResourceFile.EPAResource);
