            txtUserName.ReadOnly = true;

            int CompanyID = Convert.ToInt32(hdnCompanyID.Value);

            //Populate company details
            var objCom = CompanyHelper.GetCompanyByID(CompanyID);



            if (objCom.CompanyTypeID==1)
            {

                txtCompanyNameArabi.Text = objCom.NameArabic;
                txtCompanyNameEnglish.Text = objCom.Title;
                txtCivilID.Text = objCom.CivilID;
                txtFormalEmail.Text = objCom.FormalEmail;
