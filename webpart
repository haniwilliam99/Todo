        private static DataTable CreateSourceStructure(string userName, string password, string company, string civilID, bool isPrimary)
        {
            DataTable dataSource = new DataTable();
            DataColumn dcName = new DataColumn("UserName");
            dataSource.Columns.Add(dcName);

            DataColumn dcPassword = new DataColumn("Password");
            dataSource.Columns.Add(dcPassword);

            DataColumn dcCompanyName = new DataColumn("CompanyName");
            dataSource.Columns.Add(dcCompanyName);

            DataColumn dcCompanyCivilID = new DataColumn("CivilID");
            dataSource.Columns.Add(dcCompanyCivilID);

            DataColumn dcSubTitle = new DataColumn("SubTitle");
            dataSource.Columns.Add(dcSubTitle);

            DataRow dr = dataSource.NewRow();
            dr["UserName"] = userName;
            dr["Password"] = password;
            dr["CompanyName"] = company;
            dr["CivilID"] = civilID;
            dr["SubTitle"] = isPrimary ? Util.GetLocalizedValue("MainUserDetailHeader", Util.ResourceFile.EPAResource) : Util.GetLocalizedValue("SecondaryUserDetailHeader", Util.ResourceFile.EPAResource);
            dataSource.Rows.Add(dr);
            return dataSource;
        }

