                //TODO
                txtComCentralNumber.Text = objCom.CentralNumber;
                hdnLicIssueDate.Value = txtLicIssuedDate.Text = objCom.LicIssueDate;
                hdnLicEndDate.Value = txtLicExpiryDate.Text = objCom.LicExpiryDate;
                cblCompanytType.SelectedValue="1";
                DivGovSector.Visible=false;
                DivPrivateCompany.Visible=true;
            }
            else
            {
                cblCompanytType.SelectedValue="2";
                txtGovNameAr.Text = objCom.NameArabic;
                txtGovNameEn.Text = objCom.Title;

                DivGovSector.Visible=true;
                DivPrivateCompany.Visible=false;
            }



            chkStopOnlineService.Checked = (Convert.ToBoolean(objCom.IsBlockedManually) == true) ? true : Convert.ToBoolean(objCom.IsBlockedBySystem);
            hdnChekcBoxOrigninalVlaue.Value = Convert.ToString(Convert.ToInt32(chkStopOnlineService.Checked));


            BindRequiredAttachmentDocs(CompanyID);
            BindRequestStatusHistoryByCompany();

            var lstCompanyUsers = CompanyHelper.GetCompanyUsersByCompanyID(CompanyID);
            if (lstCompanyUsers.Count > 0)
            {
