        private void AddCompany()
        {
            try
            {
                if (!isValidateRequiredDocuments())
                {
                    ShowNotification(string.Format(Util.GetLocalizedValue("MaxFileSize", Util.ResourceFile.EPAMessage), Configuration.GetConfigurationValue(ConfigurationKey.MaxFileSizeInMB)), EPAOzoneDAL.Enumerations.NotificationTypes.Warning, false);
                    return;
                }
                var obj = new EPAOzoneDAL.DBcontext.Company();
                obj.Title = txtCompanyNameEnglish.Text;
                obj.NameArabic = txtCompanyNameArabi.Text;
                obj.CivilID = txtCivilID.Text;
                obj.FormalEmail = txtFormalEmail.Text;
                obj.PhoneNumber = txtPhoneNumber.Text;
                obj.Address = txtOfficeAddress.Text;
                obj.CommercialRegNo = txtCommercialRegistrationNumber.Text;


                //TODO
                obj.CentralNumber = Convert.ToString(txtComCentralNumber.Text).Trim();
                obj.LicIssueDate = Convert.ToString(hdnLicIssueDate.Value).Trim();
                obj.LicExpiryDate = Convert.ToString(hdnLicEndDate.Value).Trim();

                hdnCompanyID.Value = CompanyHelper.AddCompany(obj).ToString();
                ViewState["CompanyName"] = txtCompanyNameEnglish.Text;
                // ViewState["CompanyName"] = txtCompanyNameArabi.Text;
                ViewState["CompanyCivilID"] = txtCivilID.Text;

                if (hdnCompanyID.Value != null)
                {
                    hdnAddEditMode.Value = "Update";

                    if (grdCompanyRegistrationDocs.Rows.Count > 0)
                    {
                        List<EPAOzoneDAL.CompanyRegistrationAttachment> objRegistrationDocs = new List<EPAOzoneDAL.CompanyRegistrationAttachment>();
                        EPAOzoneDAL.CompanyRegistrationAttachment objRegistrationItem;

                        foreach (GridViewRow grv in grdCompanyRegistrationDocs.Rows)
                        {
                            objRegistrationItem = new EPAOzoneDAL.CompanyRegistrationAttachment();

                            objRegistrationItem.RegistrationDocumentID = Convert.ToInt32(grdCompanyRegistrationDocs.DataKeys[grv.DataItemIndex].Values["ID"]);
                            objRegistrationItem.FileName = ((FileUpload)grv.FindControl("fupAttachDoc")).FileName;
                            objRegistrationItem.Attachment = ((FileUpload)grv.FindControl("fupAttachDoc")).FileBytes;

                            objRegistrationDocs.Add(objRegistrationItem);
                        }

                        CompanyHelper.AddCompanyRegistrationAttachments(Convert.ToInt32(hdnCompanyID.Value), objRegistrationDocs);
                    }

                    var objCompanyUser = new EPAOzoneDAL.DBcontext.CompanyUser();

                    objCompanyUser.CompanyId = Convert.ToInt32(hdnCompanyID.Value);//Company.GetCompanyByID(Convert.ToInt32(hdnCompanyID.Value));
                    objCompanyUser.Title = txtMainUserNameEnglish.Text;
                    objCompanyUser.NameArabic = txtMainUserNameArabic.Text;
                    objCompanyUser.CivilID = txtMainUserCivilID.Text;
                    objCompanyUser.Designation = txtMainUserDesignation.Text;
                    objCompanyUser.MobileNumber = txtMainUserMobile.Text;
                    objCompanyUser.Email = txtMainUserEmailID.Text;
                    //objCompanyUser.PhoneNumber = txtMainUserLandline.Text;
                    objCompanyUser.SerialNumber = Convert.ToString(txtMainUserSerialNumber.Text).Trim();
                    string filename = string.Empty;
                    byte[] bytesArray = null;

                    UserCredential objUCred = CompanyHelper.AddCompanyUserwithNameandPassword(objCompanyUser, txtUserName.Text.Trim(), txtPassword.Text.Trim(), filename, bytesArray);
                    ViewState["MainUserPassword"] = objUCred.Password;
                    txtUserName.Text = objUCred.UserName;

                    btnMainUserPrintPassword.Enabled = true;
                    btnMainUserPrintPassword.Visible = true;
                    btnMainUserGeneratePassword.Visible = true;

                    Notification.SendSMSNotification(MessageCode.NewUserAccount, "##User##=" + objCompanyUser.NameArabic + ";##UserName##=" + objUCred.UserName + ";##Password##=" + objUCred.Password, txtMainUserMobile.Text);
                    Notification.SendEmailNotification(MessageCode.NewUserAccount, "##User##=" + objCompanyUser.NameArabic + ";##UserName##=" + objUCred.UserName + ";##Password##=" + objUCred.Password, txtMainUserEmailID.Text);

                    if (chkSecondaryUserDetails.Checked)
                    {
